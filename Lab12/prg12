
#include<keypad.h>
const byte ROWS=4;
const byte COLS=3;
char keys[ROWS][COLS]={
  {'1','2','3'},
  {'4','5','6'},
  {'7','8','9'},
  {'*','0','#'}
};
byte rowPins[ROWS]=
{9,8,7,6};
byte colPins[COLS]={5,4,3};
Keypad keypad=keypad(makeleymap(keys),rowPins,colPins,ROWS,COLS);

   
void setup()
{
  Serial.begin(9600);
  Serial.println("Press key on keypad...");
}

void loop()
{
  char key=keypad.getkey();
  if(key){
    Serial.print("Key pressed:");
    Serial.println(key);
  }
}
